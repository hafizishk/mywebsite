{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/helpr-screens(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/spl(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/helpr(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/helpr",
      "destination": "/helpr/agency",
      "permanent": false
    },
    {
      "source": "/spl",
      "destination": "/spl/index.html",
      "permanent": false
    },
    {
      "source": "/spl/",
      "destination": "/spl/index.html",
      "permanent": false
    },
    {
      "source": "/spl/admin",
      "destination": "/spl/admin.html",
      "permanent": false
    },
    {
      "source": "/spladmin",
      "destination": "/spl/admin.html",
      "permanent": false
    },
    {
      "source": "/spladmin/",
      "destination": "/spl/admin.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/helpr/:path((?!_expo/|assets/|favicon.ico$).*)",
      "destination": "/helpr/index.html"
    }
  ]
}
